# =============================================================================
# Merged Asset + Lease + Budget backend — environment variables.
# Copy this file to `.env` and adjust values for your machine.
# =============================================================================

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (single shared database for the whole system) ---
DB_NAME=financial_management
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS (React dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend base URL — used inside password-reset emails ---
FRONTEND_URL=http://localhost:5173

# --- Email (leave EMAIL_BACKEND on console for local dev) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For SMTP delivery instead:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-address@gmail.com

# --- Legacy integration key (kept for backwards compat, no longer required) ---
INTEGRATION_API_KEY=asset-integration-key-change-in-production
